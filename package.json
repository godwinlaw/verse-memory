{
  "name": "memory-board",
  "version": "1.0.0",
  "description": "The Memory Board — a spaced-repetition Bible verse memorization app for Acts 2 Network - Berkeley.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "serve -l 8080 .",
    "start": "serve -l 8080 .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keywords": "python3 tools/gen_keywords.py",
    "build": "node scripts/build.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "htm": "^3.1.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4",
    "wrangler": "^4.42.0"
  }
}
