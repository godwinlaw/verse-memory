rules_version = '2';

// Firestore security rules for The Memory Board.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user progress documents: users/{uid} = { progress, log, updatedAt }.
    // A signed-in user (including anonymous) may read/write only their own doc.
    // Reads are open to any signed-in user so a leaderboard can aggregate
    // committed counts; no personal data beyond progress/log is stored here.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
