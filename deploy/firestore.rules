rules_version = '2';

// Firestore security rules for The Memory Board.
// Access is restricted to verified Google accounts in the Acts 2 Network
// Workspace domain (gpmail.org). This is the authoritative enforcement — the
// client-side domain check and Google `hd` hint are conveniences, not security.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isActsUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@gpmail[.]org$');
    }

    // Per-user progress documents: users/{uid} = { progress, log, updatedAt }.
    // Any signed-in gpmail.org user may read (so a leaderboard can aggregate
    // committed counts); a user may write only their own document.
    match /users/{uid} {
      allow read: if isActsUser();
      allow write: if isActsUser() && request.auth.uid == uid;
    }
  }
}
